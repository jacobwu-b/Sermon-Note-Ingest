{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transcripts/index.json",
  "description": "Metadata for every transcript under transcripts/ (Ingest spec 0010). Written by Sermon-Note-Ingest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["transcripts"],
  "properties": {
    "transcripts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["guid", "source", "preached_on", "title", "speaker", "series", "episode_url", "blurb", "path", "sha256"],
        "properties": {
          "guid": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "preached_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "title": { "type": ["string", "null"] },
          "speaker": { "type": ["string", "null"] },
          "series": { "type": ["string", "null"] },
          "episode_url": { "type": ["string", "null"] },
          "blurb": { "type": ["string", "null"] },
          "path": { "description": "The transcript file. Load it as written; never build it.", "type": "string", "pattern": "^transcripts/.+\\.txt$" },
          "sha256": {
            "description": "sha256 of the file at path. null for a record with no stored hash.",
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
