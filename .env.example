# Every env var the app reads MUST appear here.
# When you add or remove an env var in code, update this file in the same PR.
# Values here are placeholders — never commit real secrets.

# --- Church feeds (GitHub Actions repository VARIABLE, not a secret) ---
# One JSON object keyed by church name: {"rss": <feed url>, "enabled": bool, "notify": bool}.
CHURCHES={"menlo": {"rss": "https://example.org/feed.xml", "enabled": true, "notify": true}}

# --- Notification (GitHub Actions repository SECRETS) ---
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=
# RESEND_API_KEY=

# --- Transcription (GitHub Actions repository VARIABLEs, not secrets) ---
LOG_LEVEL=info
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# --- Content-repo handoff ---
# CONTENT_REPO (GitHub Actions repository VARIABLE, "owner/repo") and
# CONTENT_REPO_BRANCH (VARIABLE, defaults to "main" if unset) are not secrets.
CONTENT_REPO=owner/Sermon-Note-Content
# CONTENT_REPO_BRANCH=main

# CONTENT_REPO_TOKEN (GitHub Actions repository SECRET): a token with write access
# to Sermon-Note-Content, used to push newly-transcribed sermons there.
# CONTENT_REPO_TOKEN=
