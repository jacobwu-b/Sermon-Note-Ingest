# Every env var the app reads MUST appear here.
# When you add or remove an env var in code, update this file in the same PR.
# Values here are placeholders — never commit real secrets.

# --- Church feeds (GitHub Actions repository VARIABLE, not a secret) ---
# One JSON object keyed by church name:
#   {"rss": <feed url>, "enabled": bool, "notify": bool, "vocabulary": [<term>, ...]}
# "vocabulary" is optional: proper nouns the feed can't tell us (the church's full name,
# campus names, recurring guests) that every transcription of that church is prompted
# with. Speaker and series names already in the ledger are added automatically.
CHURCHES={"menlo": {"rss": "https://example.org/feed.xml", "enabled": true, "notify": true, "vocabulary": ["Menlo Church"]}}

# --- Notification (GitHub Actions repository SECRETS) ---
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=
# RESEND_API_KEY=

# --- Transcription (GitHub Actions repository VARIABLEs, not secrets) ---
LOG_LEVEL=info
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS (default 0 = let faster-whisper use every core it can see).
# Only needed when running several transcriptions in parallel on one machine
# (scripts/transcribe_local.py sets this per shard); leave unset for a normal
# single-run job.
# WHISPER_CPU_THREADS=0
# Decoding knobs — all optional; the defaults shown are faster-whisper's own (spec 0003).
# WHISPER_BEAM_SIZE=5
# WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
# WHISPER_DOMAIN_PROMPT: set false to stop prompting the model with per-sermon hotwords
# (speaker, series, title, church vocabulary), with no other change — the kill switch if
# prompting ever regresses quality.
# WHISPER_DOMAIN_PROMPT=true

# --- Content-repo handoff ---
# CONTENT_REPO (GitHub Actions repository VARIABLE, "owner/repo") and
# CONTENT_REPO_BRANCH (VARIABLE, defaults to "main" if unset) are not secrets.
CONTENT_REPO=owner/Sermon-Note-Content
# CONTENT_REPO_BRANCH=main

# CONTENT_REPO_TOKEN (GitHub Actions repository SECRET): a token with write access
# to Sermon-Note-Content, used to push newly-transcribed sermons there.
# CONTENT_REPO_TOKEN=

# HF_TOKEN (GitHub Actions repository SECRET): a Hugging Face access token, read
# directly by huggingface_hub (not by this repo's code) to authenticate the
# faster-whisper model weight download and avoid Hugging Face's anonymous rate limit.
# HF_TOKEN=

# TRANSCRIBE_DISPATCH_TOKEN (GitHub Actions repository SECRET): a fine-grained PAT
# scoped to this repository only with "Actions: write", read directly by the `gh` CLI
# (not by this repo's Python code) in poll.yml to dispatch transcribe.yml's
# workflow_dispatch event for a church right after discovery (ADR-0007). The default
# GITHUB_TOKEN cannot trigger another workflow's workflow_dispatch event.
# TRANSCRIBE_DISPATCH_TOKEN=

# --- Pipeline ingest-event dispatch (spec 0005, ADR-0009) ---
# PIPELINE_REPO (GitHub Actions repository VARIABLE, "owner/repo") is not a secret.
PIPELINE_REPO=owner/Sermon-Note-Pipeline

# PIPELINE_DISPATCH_TOKEN (GitHub Actions repository SECRET): a fine-grained PAT with
# "Actions: write" AND "Contents: read" on Sermon-Note-Pipeline, read by
# poller/config.py to let poller/pipeline_dispatch.py trigger Sermon-Note-Pipeline's
# pipeline.yml workflow_dispatch, carrying an ingest_event, right after a sermon's
# transcript lands in Sermon-Note-Content (Actions: write), and to let
# poller/pipeline_registry.py read Sermon-Note-Pipeline's state/registry.json to find
# pending Claude batches (Contents: read, docs/decisions/0010). Best-effort:
# Pipeline's own cron still catches anything a failed dispatch or read misses.
# PIPELINE_DISPATCH_TOKEN=

# --- Claude batch-completion poll (spec 0006, ADR-0010) ---
# ANTHROPIC_API_KEY, if set, wins over the Workload Identity Federation vars below
# (ADR-0087's precedence) — this is local development's only path. Read by
# poller/anthropic_client.py to check the status of a batch Sermon-Note-Pipeline is
# waiting on (status only — never used to submit a batch or generate a completion).
# ANTHROPIC_API_KEY=            # secret — Anthropic API key (local dev only)

# Workload Identity Federation for poll.yml's Anthropic status check (ADR-0087,
# mirrored from Sermon-Note-Pipeline). The Console resources (issuer, service
# account, federation rule) are created and owned in the Claude Console, not in
# this repo. None of the four values below is a secret (none alone can mint a
# token without a live GitHub OIDC exchange the Console rule accepts), so poll.yml
# sets them as literal strings gated on `github.ref == 'refs/heads/main'` rather
# than as repository variables. Unset locally, which leaves _get_client() on the
# ANTHROPIC_API_KEY path above.
# ANTHROPIC_FEDERATION_RULE_ID=  # the federation rule id, fdrl_... (this repo's own)
# ANTHROPIC_ORGANIZATION_ID=     # the Anthropic organization id
# ANTHROPIC_SERVICE_ACCOUNT_ID=  # the service account id, svac_...
# ANTHROPIC_WORKSPACE_ID=        # optional — only needed if the rule covers more than one workspace
# ACTIONS_ID_TOKEN_REQUEST_URL / ACTIONS_ID_TOKEN_REQUEST_TOKEN are provided by the
# Actions runner when the job has `permissions: id-token: write` — never set them
# yourself.
# ACTIONS_ID_TOKEN_REQUEST_URL=
# ACTIONS_ID_TOKEN_REQUEST_TOKEN=
